# Settings for the deploy and dashboard scripts. Copy to kiosk.env, fill in
# your own values, and source it:
#
#   cp kiosk.env.example kiosk.env && $EDITOR kiosk.env
#   set -a; . ./kiosk.env; set +a
#   ./deploy-card.sh && python3 tools/build-dashboard.py
#
# Every value below has a default in the scripts. The defaults are placeholders
# that describe the shape of a working setup, not a working setup: build
# against them and you get a dashboard full of entities that do not exist.
#
# Quote any value containing a space. This file is sourced by the shell, where
# NAME=AC Belastingen tries to run `Belastingen` as a command and leaves NAME
# set only for it, so the script quietly uses its own default instead of your
# value.

# --- Home Assistant -------------------------------------------------------
HA_WS_URL="wss://homeassistant.example.net/api/websocket"
# A long-lived access token, from your profile's Security tab. Leave it empty
# here if you would rather pass it per command.
HA_TOKEN=""

# Where Home Assistant keeps the files it serves at /local, and how to reach
# it. Only needed when Home Assistant runs in Kubernetes; the deploy copies the
# card into its container. Leave KUBE_CONTEXT empty to use the current one.
KUBE_CONTEXT=""
HA_NAMESPACE="home-assistant"
HA_POD="home-assistant-0"
HA_CONTAINER="home-assistant"
HA_WWW_DIR="/config/www/ha-kiosk"

# --- Dashboard ------------------------------------------------------------
KIOSK_DASHBOARD="kiosk-flow"
# Seconds of no interaction before any screen returns to the first one.
IDLE_SECONDS="120"

# --- Stroom: power flow ---------------------------------------------------
# Each group takes a total and, optionally, a comma-separated list of phases.
# A group with phases but no total has its phases summed, which is what to do
# when your system exposes per-phase figures only. A group with neither is
# left off the screen entirely.
GRID_ENTITY="sensor.grid_power"
GRID_PHASES="sensor.grid_power_l1,sensor.grid_power_l2,sensor.grid_power_l3"
GRID_NAME="Net"

SOLAR_ENTITY="sensor.solar_power"
SOLAR_PHASES="sensor.solar_power_l1,sensor.solar_power_l2,sensor.solar_power_l3"
SOLAR_NAME="Zon"

LOADS_ENTITY=""
LOADS_PHASES="sensor.load_power_l1,sensor.load_power_l2,sensor.load_power_l3"
LOADS_NAME="AC Belastingen"

EV_ENTITY="sensor.ev_charger_power"
EV_PHASES="sensor.ev_charger_power_l1,sensor.ev_charger_power_l2,sensor.ev_charger_power_l3"
EV_NAME="Laadpaal"

# --- Lampen ---------------------------------------------------------------
# entity=Label pairs, comma separated. Leave a label empty to keep the name
# Home Assistant already gives the entity. A light gets a brightness slider
# and a toggle; anything else gets a toggle alone.
LIGHT_ENTITIES="light.living_room=Woonkamer,light.hallway=Hal,switch.outdoor_lights=Buitenverlichting"

# --- CV&Airco -------------------------------------------------------------
CLIMATE_ENTITIES="climate.thermostat=Thermostaat,climate.upstairs=Boven,climate.living_room=Woonkamer"

# --- Deurbel --------------------------------------------------------------
DOORBELL_CAMERA="camera.doorbell"
DOORBELL_SENSORS="binary_sensor.doorbell_visitor=Bezoek,binary_sensor.doorbell_person=Persoon,binary_sensor.doorbell_motion=Beweging"
# Turning on sends whichever screen is showing to the doorbell. Use the
# button-press sensor, not motion, or passers-by take over the panel.
ALERT_ENTITY="binary_sensor.doorbell_visitor"

# --- Afval -----------------------------------------------------------------
# Calendar whose event titles are the waste streams (GFT, Papier, PMD, ...).
# Sensor carrying a per-stream date attribute for each waste type; its next
# collection is shown on the Stroom screen too.
WASTE_SENSOR="sensor.waste_collection"
TRASH_CALENDAR="calendar.waste_collection"
