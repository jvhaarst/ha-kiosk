# Configuration for the Home Assistant kiosk, sourced by ha-kiosk-launch.
# Copy to ~/.config/ha-kiosk/env on the Pi and edit.

# Base URL of Home Assistant, without a trailing slash.
HA_URL=https://homeassistant.example.net

# Path of the first screen to show, as <dashboard>/<view>.
HA_DASHBOARD=/kiosk-flow/stroom

# File holding the long-lived access token, one line, no surrounding quotes.
# Create the token in Home Assistant under your profile, Security tab,
# "Long-lived access tokens". Give this kiosk its own token so it can be
# revoked on its own. Keep the file mode at 600.
HA_TOKEN_FILE=$HOME/.config/ha-kiosk/token

# DevTools port used to seed the token. Chromium binds it to 127.0.0.1 only.
CHROMIUM_DEBUG_PORT=9222

# Dedicated browser profile. Chromium refuses remote debugging against the
# default profile directory, so the kiosk needs its own.
CHROMIUM_PROFILE=$HOME/.local/share/ha-kiosk/profile

# --- Panel blanking (ha-kiosk-screen) --------------------------------------
# The panel is off outside these hours. They follow the house heating
# programme, an hour later in the evening.
SCREEN_WAKE_WEEKDAY=07:00
SCREEN_WAKE_WEEKEND=08:00
SCREEN_SLEEP=23:30

# How long a touch wakes the screen for when it is off: long enough to do one
# thing, such as switching a light on. Another touch extends it.
SCREEN_TOUCH_SECONDS=60

# Backlight level when on, 1..max_brightness (15 on this panel). Defaults to
# the maximum. Lower is gentler on an LCD that holds a static image.
# SCREEN_BRIGHTNESS=12
